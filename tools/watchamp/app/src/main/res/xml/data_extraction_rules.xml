<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: no cloud backups, no device transfers for the same reason. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
