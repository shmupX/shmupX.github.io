# Copy to .env and source it, or export these in your shell.
export SHMUPX_RTDB_URL="https://your-project-default-rtdb.firebaseio.com"
export SHMUPX_RTDB_AUTH=""
# Unhyphenated: the code is displayed as ABCD-EFGH and stored as ABCDEFGH, and
# this value goes straight into a database path. A hyphen here addresses a node
# nothing is watching, and nothing reports an error.
export SHMUPX_BUILDER_CODE="ABCDEFGH"
export SHMUPX_AGENT_ID="character-preview"
export SHMUPX_MCP_CONFIG="./mcp.json"
