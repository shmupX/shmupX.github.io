{
  "version": "2026.9.13",
  "nodeModulesDir": "manual",
  "workspace": [
    "./packages/shmup-engine",
    "./packages/shmup-harbor"
  ],
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check --allow-import=jsr.io,esm.sh",
    "test": "deno test -A packages/shmup-engine packages/shmup-harbor tests",
    "dev": "deno run -A scripts/dev.ts",
    "dev:vite": "vite",
    "build": "deno task games:manifest && deno task deza:manifest && deno task 2028-ai:bgm && deno task dashboard:build && deno task engine:bundle && deno task netplay:bundle && vite build",
    "build:desktop": "deno run -A packages/shmup-harbor/scripts/build-desktop.ts desktop",
    "build:windows": "deno run -A packages/shmup-harbor/scripts/build-desktop.ts windows",
    "build:linux": "deno run -A packages/shmup-harbor/scripts/build-desktop.ts linux",
    "build:mac": "deno run -A packages/shmup-harbor/scripts/build-desktop.ts mac",
    "build:android": "deno run -A packages/shmup-harbor/scripts/build-desktop.ts android",
    "build:ios": "deno run -A packages/shmup-harbor/scripts/build-desktop.ts ios",
    "shelf:list": "deno run -A packages/shmup-harbor/scripts/build-desktop.ts android --list",
    "build:ps2": "deno run -A packages/shmup-harbor/scripts/build-ps2.ts",
    "build:ps2:zip": "deno run -A packages/shmup-harbor/scripts/build-ps2.ts --zip",
    "build:ps2:iso": "deno run -A packages/shmup-harbor/scripts/build-ps2.ts --iso",
    "build:sav": "deno run -A packages/shmup-harbor/scripts/build-sav.ts",
    "sav:run": "deno run -A packages/shmup-harbor/scripts/run-mednafen.ts",
    "sav:inject": "deno run -A packages/shmup-harbor/scripts/sav-inject.ts",
    "sav:profile": "deno run -A packages/shmup-harbor/tools/sav-profiler/main.ts",
    "2028-ai:bgm": "deno run -A scripts/2028-ai/download-custom-bgm.ts",
    "games:manifest": "deno run -A scripts/build-games-manifest.ts",
    "eshop:check": "deno test -A tests/eshop_catalog_test.ts",
    "eshop:covers": "deno run -A scripts/backfill-eshop-covers.ts",
    "deza:manifest": "deno run -A scripts/build-deza-saves-manifest.ts",
    "deza:upload": "deno run -A scripts/upload-deza-saves.ts",
    "sfc:upload": "deno run -A scripts/upload-sfc-saves.ts",
    "deza:disc": "deno run -A tools/deza-disc/main.ts",
    "sfc:probe": "deno run -A tools/sfc-sav/main.ts",
    "psx:probe": "deno run -A tools/psx-sav/main.ts",
    "powerups:atlas": "deno run -A scripts/build-powerup-atlas.ts",
    "deza:tonebank": "deno run -A packages/shmup-harbor/scripts/build-tone-bank.ts",
    "deza:meshlib": "deno run -A scripts/build-mesh-library.ts",
    "deza:palette": "deno run -A scripts/build-palette.ts",
    "tonebank:table": "deno run -A scripts/build-tone-bank-table.ts",
    "mcp:character": "deno run -A --node-modules-dir=none mcp/server.ts",
    "dashboard:build": "deno run -A scripts/build-dashboard.ts",
    "engine:bundle": "deno run -A scripts/build-engine.ts",
    "netplay:bundle": "deno run -A scripts/build-netplay.ts",
    "netplay:generate": "cd spacetimedb && spacetime generate --lang typescript --out-dir ../static/netplay/bindings --module-path module",
    "netplay:publish": "cd spacetimedb && spacetime publish shmupx-netplay --yes",
    "player2:art": "deno run -A scripts/build-player2-art.ts",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ],
      "exclude": [
        "react-no-danger"
      ]
    }
  },
  "exclude": [
    "**/._*",
    "dev-fixtures/.cache/**",
    "**/_fresh/*",
    ".claude/**",
    ".deno/**",
    "build/**",
    "node_modules/**",
    "spacetimedb/**",
    "static/**",
    "svelte-src/**",
    "packages/shmup-harbor/tools/build-level/**"
  ],
  "imports": {
    "@/": "./",
    "@easierbycode/svelte-ps2": "jsr:@easierbycode/svelte-ps2@^1.1.0",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.1.3",
    "@types/node": "npm:@types/node@^22.12.0",
    "svelte": "npm:svelte@^5.16.0",
    "esbuild": "npm:esbuild@^0.24.0",
    "esbuild-svelte": "npm:esbuild-svelte@^0.9.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/encoding": "jsr:@std/encoding@^1.0.0",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@~1.29.0",
    "zod": "npm:zod@^4.4.3"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  },
  "deploy": {
    "install": "deno install",
    "build": "deno task build",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "./_fresh/server.js"
    }
  },
  "desktop": {
    "app": {
      "identifier": "games.codemonkey.shmupx"
    },
    "release": {
      "baseUrl": "https://codemonkey.games/desktop"
    }
  }
}
