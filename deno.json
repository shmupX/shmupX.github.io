{
  "nodeModulesDir": "manual",
  "workspace": [
    "./packages/shmup-engine"
  ],
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check --allow-import=jsr.io,esm.sh",
    "test": "deno test -A packages/shmup-engine",
    "dev": "deno run -A scripts/dev.ts",
    "dev:vite": "vite",
    "build": "deno task games:manifest && deno task 2028-ai:bgm && deno task dashboard:build && deno task engine:bundle && vite build",
    "2028-ai:bgm": "deno run -A scripts/2028-ai/download-custom-bgm.ts",
    "games:manifest": "deno run -A scripts/build-games-manifest.ts",
    "dashboard:build": "deno run -A scripts/build-dashboard.ts",
    "engine:bundle": "deno run -A scripts/build-engine.ts",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ],
      "exclude": [
        "react-no-danger"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*",
    ".claude/**",
    ".deno/**",
    "build/**",
    "node_modules/**",
    "static/**",
    "svelte-src/**",
    "tools/build-level/**"
  ],
  "imports": {
    "@/": "./",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.1.3",
    "svelte": "npm:svelte@^5.16.0",
    "esbuild": "npm:esbuild@^0.24.0",
    "esbuild-svelte": "npm:esbuild-svelte@^0.9.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.0",
    "@std/cli": "jsr:@std/cli@^1.0.0"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  },
  "deploy": {
    "org": "easierbycode",
    "app": "shmupx"
  }
}
