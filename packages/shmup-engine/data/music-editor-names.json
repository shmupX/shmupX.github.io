{
  "meta": {
    "about": "What Dezaemon 2's music editor 音まろ calls and shows things, for the web music maker. Text facts only: no disc art, sample audio or song data is in this file. See README.md \"音まろ, the native music editor\" for how each field was established.",
    "source": "Saturn disc: overlay S_EDIT.CMP (decompressed, loads at 0x06064000; offsets below are into the decompressed file), its sprite file SPR_SND.CMP and its help file HL_MUSIC.CMP. Read 2026-10-28 (spike S4).",
    "nativeNames": "音まろ prints no name for any instrument, band, groove, mood or sample song. S_EDIT holds no Shift-JIS text at all, and each of those is drawn as a sprite from SPR_SND. So instruments, bands, grooves, chords and sampleSongs hold null for every entry: there is no native name to record, and none may be invented here.",
    "descriptions": "instrumentIcons, bandIcons and chordFaces are our own plain-English descriptions of the native picture, not names the game uses; null where the picture is ambiguous. The editor draws its own original icons and must not copy these pictures.",
    "offsets": {
      "spriteTable": "S_EDIT +0xFD00 (0x06073D00): 321 entries of {u16 w, u16 h, u16 vramAddr/8, u16 vdp1Size}; sprite pixels at SPR_SND +0x200 + (vramAddr - 0x2000) * 8, 8bpp, palette = SPR_SND's first 512 bytes (256 RGB555 big-endian)",
      "instrumentIcons": "palette button sprites 108 + instrument (light) and 168 + instrument (dark); a note on the staff is sprite 228 + voice byte, and a tie (voice bit 7) is sprite 20 (S_EDIT +0x4C98..+0x4CAE)",
      "instrumentGroups": "group index u16 at 0x06079CE8 wraps 0..14; the four buttons show instruments group*4 + 0..3; the group number is drawn with digit sprites 8-17 (1-10) and 76-80 (11-15) (S_EDIT +0x1774..+0x17DC)",
      "bands": "band sprite = 63 + ctrl0 (S_EDIT +0x08EA..+0x090C); stepping ctrl0 down from 0 wraps to 8 (S_EDIT +0x1EA6)",
      "chords": "mood face sprite = 42 + (ctrl2 & 0x7F) (S_EDIT +0x0714..+0x072E); the editor steps it by 2 and keeps bit 7 (S_EDIT +0x2040..+0x2088), so it only writes 0, 2, 4, 6, 8",
      "keys": "letter sprite = table at S_EDIT +0x13584 [ctrl3] (89 = A .. 95 = G); sharp sign (sprite 101) shown when table at S_EDIT +0x13590 [ctrl3] is 1",
      "bassToggle": "a button toggles sprite 35 (a bass guitar on a staff) and ctrl2 bit 7 together (flag 0x060776D6, S_EDIT +0x20D0..+0x2108)",
      "sampleSongs": "song index u16 at 0x06079CE0 wraps 0..96 (S_EDIT +0x1128..+0x11CE); 0-23 copy the save's own slot, 24-96 load request entry index-24 from S_EDIT +0x14D6C ({name pointer, 0x0607D010}) whose names are M_DATA01..79.BIN (S_EDIT +0x561C, stored 79 down to 01). Only 73 files exist and index 96 is the last reachable, so M_DATA74-79 are dead entries",
      "help": "HL_MUSIC.CMP: a .CMP whose payload is 35 separately compressed 256x16 4bpp text panels; offset/length table at S_EDIT +0x15A04 (16 bytes each), decoded one by one by the kernel LZSS at 0x06004FF8 (S_EDIT +0x5E44..+0x5E6E)"
    }
  },
