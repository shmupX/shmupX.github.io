_fresh/
node_modules/
vendor/
# Claude Code's directory is local: a launch.json pointing at this machine's
# ports, and the worktrees sessions run in. skills/, hooks/ and settings.json
# are the exceptions — a skill is a shared repo asset, checked in so a clone
# gets it, and the SessionStart hook has to reach a web session's container to
# do its job at all. The negations need the glob rather than the bare
# directory: git cannot re-include anything inside an excluded DIRECTORY, only
# inside an excluded set of paths.
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
.deno/
build/
static/games/2028-ai/assets/custom-bgm/

# The eShop install archive Super Mario SP had until it left the
# catalogue. It is byte-for-byte derivable from static/games/super-mario-sp/
# by `deno task super-mario-sp:zip`, which `deno task build` no longer runs
# -- and the repo never carried ~2.3MB of incompressible duplicate.
static/games/super-mario-sp-web.zip
# The same for the 2019 game's PS2 web build: `deno task 2019:zip` packs it
# from static/games/2019/level.json and this checkout's game.bundle.js.
static/games/2019-web.zip
# And EVIL INVADERS '95's: `deno task 95-demo:zip` builds its record from
# scripts/95-demo/ and packs it with this checkout's game.bundle.js.
static/games/95-demo-web.zip
# Nothing here for a game's PS2 download page (`deno task ps2:page`): its
# disc, its USB zip and its play/ build are committed with the page. `deno
# task build` does not make them, and Deploy serves only what git carries, so
# ignoring them leaves the page with three dead links (as /games/squad/ had at
# first).

# Finder's per-directory metadata. No leading slash, so it is ignored at every
# depth — macOS drops one into any folder it has been browsed in.
.DS_Store

# AppleDouble resource forks. macOS writes a ._<name> sidecar beside every
# file it touches on a filesystem that cannot hold extended attributes, and
# this checkout lives on an exFAT volume — so they appear by the hundred.
# No leading slash, for the same reason .DS_Store has none.
._*

# The Dezaemon cartridge, staged under static/ by `deno task sfc:stage` so the
# Super Famicom player can boot it in a packaged launcher as well as in dev
# (a compiled binary embeds _fresh/client, which is static/, and never
# dev-fixtures/). Athena's ROM is not ours to ship, and this is what keeps the
# copy local: Deno Deploy builds from this repository, so a file git does not
# carry is a file `vite build` cannot copy into the deployed site.
static/snes/*.sfc
static/snes/*.smc

# The same for Dezaemon 3D and the 64DD IPL, staged under static/n64dd/ by
# `deno task n64:stage` for the Nintendo 64DD player. The translation patch
# beside them (an .xdelta) is the fan translation's own release and stays
# committed; the cartridge and Nintendo's IPL are not ours to ship.
static/n64dd/*.z64
static/n64dd/*.n64
static/n64dd/*.v64
static/n64dd/*.bin

# The Nintendo Switch pack's content, staged under static/ for `deno task
# members:pack` to put in shmupx-member-switch.zip (lib/member-content.ts):
# the cartridges and their covers (the list beside them is committed, empty,
# and `deno task switch:manifest` rewrites it from what is here), the Voland
# core scripts/build-voland-core.sh builds -- a GPL artifact that must not
# ride into a commit or a deploy -- and the keys dumped from your own console.
# No packaged build embeds any of it (lib/streamed-payloads.ts).
static/NintendoSwitch/*
!static/NintendoSwitch/manifest.json
static/switch/core/
static/switch/keys/

# Local .sav test fixtures (community Dezaemon 2 saves — never committed).
# Drop .sav/.bcr/.bkr files here to enable the fixture-gated engine tests.
# debug-tools/ is the exception — scripts that read the fixtures, not the
# fixtures themselves.
dev-fixtures/*
!dev-fixtures/debug-tools/
packages/shmup-engine/fixtures/

# The community save collection. It lives in the Realtime Database instead
# (`deno task deza:upload` — /dezaemon/saves, with covers and metadata), so it
# does not ride along in every clone and every Deploy build as 275MB of .sav.
# Keep the files here locally: the editor's shelf and deza:upload both read
# them, and `deno task deza:manifest` writes an empty manifest when they are
# absent rather than failing.
static/editor/dezaemon/saves/

# The SpacetimeDB module's build output and its npm tree. `spacetime build`
# regenerates dist/bundle.js from spacetimedb/module/src, and the SDK there is
# also what scripts/build-netplay.ts bundles the browser client against — so it
# is a normal `npm install`, not something to commit.
spacetimedb/module/dist/
spacetimedb/module/node_modules/

# Cloud level records pulled down before something overwrote them
# (`levels/<name>` in the Realtime Database). They are user data rather than
# source, and one is ~7MB — most of it the level's atlas as a data URL — so the
# records stay out of the repo and out of the deploy. The README that says how
# to restore one does not.
backups/*
!backups/README.md
# The Sprite Picker archive https://codemonkey.games/extension hands out, and
# the facts the page shows beside it: `deno task extension:zip` (in `build`)
# packs tools/sprite-picker-extension/ fresh for every deploy.
static/extension/shmupx-sprite-picker.zip
static/extension/meta.json

# daily-champion private keys (scripts/daily-champion-keys.ts --secret-out)
*champion-keys*.json
DAILY_CHAMPION_KEYS*
